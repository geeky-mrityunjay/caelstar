  "faq": [
    {
      "q": "How soon can we start?",
      "a": "Most projects begin within a week of our first call."
    },
    {
      "q": "Can I change plans later?",
      "a": "Yes. You can upgrade or downgrade at the start of any month."
    },
    {
      "q": "Is GST included in the price?",
      "a": "No. Prices are before GST, which is added to your invoice."
    },
    {
      "q": "Can I buy a single service?",
      "a": "Yes. Tell us what you need and we will suggest the closest plan or a custom quote."
    },
    {
      "q": "Do I need to sign a long contract?",
      "a": "No. Plans are billed monthly."
    },
    {
      "q": "Who owns my website, data and accounts?",
      "a": "You do. Everything we build and collect is yours."
    },
    {
      "q": "What happens after launch?",
      "a": "We keep maintaining, reporting and improving, based on your plan."
    },
    {
      "q": "How do I join the seller programme?",
      "a": "Seller access is by invitation. Email us and we will reply if approved."
    },
    {
      "q": "How do we get started?",
      "a": "Press Get Started, email us, and we will set up a short call."
    }
